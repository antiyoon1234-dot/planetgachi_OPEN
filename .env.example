# Browser-safe values from Supabase Dashboard → Settings → API.
# Do NOT use the service_role key in this file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_AUCTION_PROXY_URL=https://your-project-ref.supabase.co/functions/v1/auction-proxy

# Optional local development proxy target. Not exposed by Vite to the browser.
DEV_PROXY_TARGET=http://localhost:8080
